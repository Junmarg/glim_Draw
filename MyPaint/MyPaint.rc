    CTEXT           "×",IDC_STATIC,82,124,10,8
    EDITTEXT        IDC_FG_HEIGHT,94,122,40,12,ES_NUMBER
    LTEXT           "픽셀",IDC_STATIC,138,124,30,8
    LTEXT           "선 굵기:",IDC_STATIC,14,140,30,8
    EDITTEXT        IDC_FG_LINE,46,138,30,12,ES_NUMBER
    LTEXT           "픽셀 (선 = 색 1, 배경 = 색 2)",IDC_STATIC,80,140,116,8
