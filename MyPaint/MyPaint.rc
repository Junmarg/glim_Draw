/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_MAIN_MENU MENU
BEGIN
    POPUP "파일(&F)"
    BEGIN
        MENUITEM "새로 만들기(&N)\tCtrl+N",          ID_FILE_NEW_IMAGE
        MENUITEM "열기(&O)...\tCtrl+O",              ID_FILE_OPEN_IMAGE
        MENUITEM "저장(&S)\tCtrl+S",                 ID_FILE_SAVE_IMAGE
        MENUITEM "다른 이름으로 저장(&A)...\tF12",   ID_FILE_SAVE_IMAGE_AS
        MENUITEM SEPARATOR
        MENUITEM "인쇄(&P)...\tCtrl+P",              ID_FILE_PRINT_IMG
        MENUITEM "인쇄 미리 보기(&V)...",            ID_FILE_PRINT_PREVIEW_IMG
        MENUITEM "페이지 설정(&U)...",               ID_FILE_PAGE_SETUP_IMG
        MENUITEM SEPARATOR
        POPUP "바탕 화면 배경으로 설정(&B)"
        BEGIN
            MENUITEM "채우기(&F)",                   ID_FILE_WALLPAPER_FILL
            MENUITEM "바둑판식 배열(&T)",            ID_FILE_WALLPAPER_TILE
            MENUITEM "가운데(&C)",                   ID_FILE_WALLPAPER_CENTER
        END
        POPUP "최근 파일(&R)"
        BEGIN
            MENUITEM "(없음)",                       ID_FILE_RECENT_NONE, GRAYED
        END
        MENUITEM SEPARATOR
        MENUITEM "끝내기(&X)",                       ID_FILE_EXIT
    END
    POPUP "편집(&E)"
    BEGIN
        MENUITEM "실행 취소(&U)\tCtrl+Z",            ID_EDIT_UNDO_ACTION
        MENUITEM "다시 실행(&R)\tCtrl+Y",            ID_EDIT_REDO_ACTION
        MENUITEM SEPARATOR
        MENUITEM "잘라내기(&T)\tCtrl+X",             ID_EDIT_CUT_SEL
        MENUITEM "복사(&C)\tCtrl+C",                 ID_EDIT_COPY_SEL
        MENUITEM "붙여넣기(&P)\tCtrl+V",             ID_EDIT_PASTE_IMG
        MENUITEM "선택 영역 삭제(&D)\tDel",          ID_EDIT_DELETE_SEL
        MENUITEM SEPARATOR
        MENUITEM "모두 선택(&A)\tCtrl+A",            ID_EDIT_SELECT_ALL_IMG
        MENUITEM "선택 영역 반전(&I)\tCtrl+Shift+I",  ID_EDIT_INVERT_SEL
    END
    POPUP "이미지(&I)"
    BEGIN
        MENUITEM "자르기(&C)\tCtrl+Shift+X",         ID_IMAGE_CROP
        MENUITEM "크기 조정 및 기울이기(&Z)...\tCtrl+W", ID_IMAGE_RESIZE_SKEW
        MENUITEM SEPARATOR
        MENUITEM "오른쪽으로 90° 회전(&R)",          ID_IMAGE_ROTATE_RIGHT
        MENUITEM "왼쪽으로 90° 회전(&L)",            ID_IMAGE_ROTATE_LEFT
        MENUITEM "180° 회전(&T)",                    ID_IMAGE_ROTATE_180
        MENUITEM "상하 대칭(&V)",                    ID_IMAGE_FLIP_VERTICAL
        MENUITEM "좌우 대칭(&H)",                    ID_IMAGE_FLIP_HORIZONTAL
        MENUITEM SEPARATOR
        MENUITEM "투명 선택(&P)",                    ID_IMAGE_TRANSPARENT_SEL
        MENUITEM SEPARATOR
        MENUITEM "함수 그래프 넣기(&G)...\tCtrl+Shift+G", ID_IMAGE_FUNCTION_GRAPH
        MENUITEM SEPARATOR
        MENUITEM "이미지 속성(&A)...\tCtrl+E",       ID_IMAGE_PROPERTIES
    END
    POPUP "보기(&V)"
    BEGIN
        MENUITEM "확대(&I)\tCtrl+PgUp",              ID_VIEW_ZOOM_IN
        MENUITEM "축소(&O)\tCtrl+PgDn",              ID_VIEW_ZOOM_OUT
        MENUITEM "100%(&1)\tCtrl+0",                 ID_VIEW_ZOOM_100
        MENUITEM SEPARATOR
        MENUITEM "눈금자(&R)\tCtrl+R",               ID_VIEW_RULERS
        MENUITEM "격자선(&G)\tCtrl+G",               ID_VIEW_GRID
        MENUITEM "상태 표시줄(&S)",                  ID_VIEW_STATUSBAR
        MENUITEM SEPARATOR
        MENUITEM "전체 화면(&F)\tF11",               ID_VIEW_FULLSCREEN
    END
    POPUP "도움말(&H)"
    BEGIN
        MENUITEM "단축키 목록(&K)\tF1",              ID_HELP_SHORTCUTS
    END
END

